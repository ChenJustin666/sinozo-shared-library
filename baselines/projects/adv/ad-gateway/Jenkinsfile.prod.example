@Library('k8s-deploy-lib@main') _

// The production Jenkins Job loads this file from the protected ops repository.
k8sDeploy(
    projectName:   'adv',
    serviceName:   'ad-gateway',
    serviceType:   'java',
    dockerImage:   'ad-gateway',
    dockerCredId:  'docker-swr-cred',
    gitUrl:        '<business-repository-url>',
    gitCredId:     '<business-git-credential-id>',
    defaultBranch: 'master',
    jdkTool:       'jdk 17',
)
